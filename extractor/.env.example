# Credenciales del portal
CLIENT_NAME_USER=tu_email@example.com
CLIENT_NAME_PASS=tu_password

# URL base del portal (debe incluir el esquema https://)
PORTAL_BASE_URL=https://portal-operativo.example.com

# Configuración de Playwright
HEADLESS=False
TIMEOUT=30000
MAX_RETRIES=3
# Logging
LOG_LEVEL=INFO